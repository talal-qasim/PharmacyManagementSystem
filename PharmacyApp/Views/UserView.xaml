<Window x:Class="PharmacyApp.Views.UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PharmacyApp.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="User Editor" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Poppins">

    <Window.Resources>
        <ObjectDataProvider x:Key="UserRoleEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:UserRoleEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentColor}" Margin="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="User Account" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Full Name" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Model.FullName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="0,0,0,12"/>

                <TextBlock Text="Username" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Model.Username, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="0,0,0,12"/>

                <TextBlock Text="Password (leave blank to keep current)" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="0,0,0,12"/>

                <TextBlock Text="Role" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource UserRoleEnumValues}}" SelectedItem="{Binding Model.Role}" Height="34" Margin="0,0,0,12"/>

                <CheckBox Content="Is Active" IsChecked="{Binding Model.IsActive}" Margin="0,8,0,0"/>

                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerColor}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="80" Height="32" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="80" Height="32" Click="CancelButton_Click"/>
            </StackPanel>
        
            <Button Grid.Row="0" Grid.ColumnSpan="10" Content="✕" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource SecundaryTextColor}" BorderThickness="0" Command="{Binding CancelCommand}"/>
        </Grid>
    </Border>
</Window>
