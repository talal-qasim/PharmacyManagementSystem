<Window x:Class="PharmacyApp.Views.PurchaseItemListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Purchase Items"
        SizeToContent="Height" Width="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="Poppins">

    <Border Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
            CornerRadius="8" Margin="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Purchase.Id, StringFormat='Items — Purchase #{0}'}"
                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="Add Item" Width="100" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Command="{Binding UpdateCommand}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Delete" Width="90" Height="32" Command="{Binding DeleteCommand}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding PurchaseItems}"
                      SelectedItem="{Binding SelectedPurchaseItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Medicine" Binding="{Binding ProductVariant.Medicine.Name}" Width="140"/>
                    <DataGridTextColumn Header="Variant" Binding="{Binding ProductVariant.Strength}" Width="90"/>
                    <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="100"/>
                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=d}" Width="90"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Cost/Unit" Binding="{Binding PurchaseCost, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding GrandTotal, StringFormat='Grand Total: {0:C}'}"
                       FontWeight="Bold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Right" Margin="0,12,0,0"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" Width="90" Height="34" Click="CloseButton_Click"/>
            </StackPanel>
        
            <Button Grid.Row="0" Grid.ColumnSpan="10" Content="✕" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource SecundaryTextColor}" BorderThickness="0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>