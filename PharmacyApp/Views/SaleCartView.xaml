<Window x:Class="PharmacyApp.Views.SaleCartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PharmacyApp.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Point of Sale"
        Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="Poppins">

    <Window.Resources>
        <ObjectDataProvider x:Key="PaymentMethodEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PaymentMethodEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundColor}"
            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
            CornerRadius="8" Margin="12">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Close -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Point of Sale"
                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,16"/>
            
            <Button Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Content="✕" Width="36" Height="32" Click="CloseButton_Click"
                    Background="Transparent" Foreground="{DynamicResource SecundaryTextColor}" BorderThickness="0"/>

            <!-- Left Panel: Search -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Search Products (Name, Generic, Barcode)" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="0,0,0,12"/>
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding SearchResults}"
                          BorderThickness="1" BorderBrush="{DynamicResource SecundaryBackgroundColor}" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4" Width="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SellingPrice, StringFormat=C}" Foreground="{DynamicResource AccentColor}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Add" Width="50" Height="28" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Right Panel: Cart -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductVariant.DisplayName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPriceAtSale, StringFormat=C}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=C}" Width="100" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Remove" 
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Prescription Required" Foreground="Red" FontWeight="Bold" 
                                   Visibility="{Binding RequiresPrescription, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PrescriptionReference, UpdateSourceTrigger=PropertyChanged}" 
                                 Visibility="{Binding RequiresPrescription, Converter={StaticResource BoolToVis}}"
                                 Height="34" Padding="8,4" MaxWidth="250" HorizontalAlignment="Left"
                                 ToolTip="Enter Prescription Reference"/>
                        
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Subtotal:" HorizontalAlignment="Left" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat=C}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Discount:" HorizontalAlignment="Left" Foreground="{DynamicResource SecundaryTextColor}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="28" HorizontalAlignment="Right" Padding="4"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Total:" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Text="{Binding Total, StringFormat=C}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        </Grid>

                        <TextBlock Text="Payment Method" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource PaymentMethodEnumValues}}"
                                  SelectedItem="{Binding SelectedPaymentMethod}" Height="34" Margin="0,0,0,12"/>

                        <TextBlock Text="Amount Paid" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="0,0,0,16"/>

                        <Button Content="Complete Sale" Height="48" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CheckoutCommand}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
