<Window x:Class="PharmacyApp.Views.StockAdjustmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:PharmacyApp.Images.Helpers"
        Title="Adjust Stock"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="Poppins"
        helpers:DialogCloser.DialogResult="{Binding CloseDialog}">

    <Border Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
            CornerRadius="8" Margin="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Adjust Stock" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding Batch.BatchNumber, StringFormat='Batch: {0}'}"
                           Foreground="{DynamicResource PrimaryTextColor}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Batch.Quantity, StringFormat='Current Quantity: {0}'}"
                           Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,16"/>

                <TextBlock Text="Reason Type" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AllowedTransactionTypes}" SelectedItem="{Binding SelectedTransactionType}"
                          Padding="8" Margin="0,0,0,12"/>

                <TextBlock Text="Quantity Change (negative to remove, positive to add)"
                           Foreground="{DynamicResource SecundaryTextColor}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox Text="{Binding QuantityChange, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ResultingQuantity, StringFormat='Resulting Quantity: {0}'}"
                           Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <TextBlock Text="Reason / Notes" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerColor}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                <Button Content="Save" Width="90" Height="34" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        
            <Button Grid.Row="0" Grid.ColumnSpan="10" Content="✕" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource SecundaryTextColor}" BorderThickness="0" Command="{Binding CancelCommand}"/>
        </Grid>
    </Border>
</Window>