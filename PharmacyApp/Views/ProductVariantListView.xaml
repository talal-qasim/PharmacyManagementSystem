<Window x:Class="PharmacyApp.Views.ProductVariantListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Variants"
        SizeToContent="Height" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="Poppins">

    <Border Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
            CornerRadius="8" Margin="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding MedicineName, StringFormat='Variants — {0}'}"
                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="Add Variant" Width="120" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
                <Button Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UpdateCommand}"/>
                <Button Content="Delete" Width="90" Height="32" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding ProductVariants}"
                      SelectedItem="{Binding SelectedProductVariant}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="110"/>
                    <DataGridTextColumn Header="Dosage Form" Binding="{Binding DosageForm}" Width="110"/>
                    <DataGridTextColumn Header="Package Size" Binding="{Binding PackageSize}" Width="110"/>
                    <DataGridTextColumn Header="Stock Unit" Binding="{Binding StockUnit}" Width="90"/>
                    <DataGridTextColumn Header="Units/Package" Binding="{Binding UnitsPerPackage}" Width="100"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Min Stock" Binding="{Binding MinimumStockLevel}" Width="80"/>
                    <DataGridTextColumn Header="Reorder Qty" Binding="{Binding ReorderQuantity}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" Width="90" Height="34" Click="CloseButton_Click"/>
            </StackPanel>
        
            <Button Grid.Row="0" Grid.ColumnSpan="10" Content="✕" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource SecundaryTextColor}" BorderThickness="0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>