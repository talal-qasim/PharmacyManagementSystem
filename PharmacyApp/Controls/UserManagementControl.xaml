<UserControl x:Class="PharmacyApp.Controls.UserManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Add User" Width="100" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
            <Button Content="Edit User" Width="100" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EditCommand}"/>
            <Button Content="Delete User" Width="100" Height="32" Foreground="{DynamicResource DangerColor}"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
