<UserControl x:Class="PharmacyApp.Controls.MedicineCategoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Add" Width="90" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
            <Button Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UpdateCommand}"/>
            <Button Content="Delete" Width="90" Height="32" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding MedicineCategories}"
                  SelectedItem="{Binding SelectedMedicineCategory}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>