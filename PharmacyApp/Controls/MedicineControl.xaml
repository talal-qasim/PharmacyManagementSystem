<UserControl x:Class="PharmacyApp.Controls.MedicineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Manage Variants" Width="130" Height="32" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ManageVariantsCommand}"/>
            <Button Content="Add" Width="90" Height="32" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
            <Button Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UpdateCommand}"/>
            <Button Content="Delete" Width="90" Height="32" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Medicines}"
                  SelectedItem="{Binding SelectedMedicine}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Generic Name" Binding="{Binding GenericName}" Width="150"/>
                <DataGridTextColumn Header="Category" Binding="{Binding MedicineCategory.Name}" Width="120"/>
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer.Name}" Width="120"/>
                <DataGridTextColumn Header="Rx" Binding="{Binding RequiresPrescription}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
