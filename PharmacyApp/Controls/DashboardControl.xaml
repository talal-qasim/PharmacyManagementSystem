<UserControl x:Class="PharmacyApp.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PharmacyApp.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="Refresh Dashboard" Width="140" Height="32"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <TextBlock Text="Inventory" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextColor}"/>
                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Active Products" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding TotalActiveProducts}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Low Stock Variants" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Out of Stock Variants" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding OutOfStockCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Expiry" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextColor}"/>
                <UniformGrid Columns="2" Margin="0,0,0,24">
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Batches Expiring Soon" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding NearExpiryBatchCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Expired Batches" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding ExpiredBatchCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Sales" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextColor}"/>
                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Sales Today" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding TodaySalesCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Revenue Today" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding TodayRevenue, StringFormat=C}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Revenue This Month" Foreground="{DynamicResource SecundaryTextColor}"/>
                            <TextBlock Text="{Binding MonthlySalesTotal, StringFormat=C}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Purchasing / Alerts" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextColor}"/>
                <Border Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="8,0,8,24">
                    <StackPanel>
                        <TextBlock Text="Recent Purchases" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid Style="{StaticResource DataGridStyle}"
                                  ItemsSource="{Binding RecentPurchases}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Purchase Id" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}" Width="150"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=d}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
