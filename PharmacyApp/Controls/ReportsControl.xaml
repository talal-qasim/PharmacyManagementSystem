<UserControl x:Class="PharmacyApp.Controls.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:PharmacyApp.Models">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="ReportTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ReportTypeEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SecundaryBackgroundColor}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Report Type" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource ReportTypeEnumValues}}"
                              SelectedItem="{Binding ReportType}" Width="180" Height="32"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0" Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="From Date" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120" Height="32"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0" Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="To Date" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120" Height="32"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0" Visibility="{Binding ShowVariantSelector, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Product Variant" Foreground="{DynamicResource SecundaryTextColor}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableVariants}" SelectedItem="{Binding SelectedVariant}"
                              DisplayMemberPath="DisplayName" Width="200" Height="32"/>
                </StackPanel>

                <Button Content="Run Report" Width="120" Height="32" VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunReportCommand}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ReportResults}" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</UserControl>
