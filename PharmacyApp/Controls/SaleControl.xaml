<UserControl x:Class="PharmacyApp.Controls.SaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Content="New Sale (POS)" Width="140" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}"/>
            <Button Content="Cancel Sale" Width="110" Height="32" Margin="0,0,8,0" 
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelSaleCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Sale Date" Binding="{Binding SaleDate, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Prescription Ref" Binding="{Binding PrescriptionReference}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
